# Porta local do serviço ia-analyze.
PORT=4100 # Local

# Token interno opcional para proteger chamadas do API Gateway.
IA_ANALYZE_INTERNAL_TOKEN= # Local/Preview/Produção

# ─────────────────────────────────────────────────────────────────────────────
# Provedor, modelo e chave não ficam neste serviço. O API Gateway envia a
# configuração OpenRouter de cada empresa nos headers internos `x-llm-*`.
# ─────────────────────────────────────────────────────────────────────────────
# Máx. de chamadas simultâneas ao LLM por requisição (evita rate limit 429).
# Comece baixo (3) — limites de RPM são por projeto. Default 3.
IA_LLM_CONCURRENCY=3 # Local/Preview/Produção
