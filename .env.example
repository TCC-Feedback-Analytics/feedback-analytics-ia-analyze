# Porta local do serviço ia-analyze.
PORT=4100 # Local

# Token interno opcional para proteger chamadas do API Gateway.
IA_ANALYZE_INTERNAL_TOKEN= # Local/Preview/Produção

# ─────────────────────────────────────────────────────────────────────────────
# Provedor de IA configurável (etapa 04). A fábrica escolhe o adaptador por env;
# na Camada 2 (BYO-key) a chave/modelo também podem vir por header, por empresa.
# ─────────────────────────────────────────────────────────────────────────────
# Qual provedor usar: 'gemini' (default, sem regressão) ou 'openrouter'.
LLM_PROVIDER=gemini # Local/Preview/Produção
# Modelo (opcional; cada provedor tem o seu default: gemini-2.5-flash / openrouter/auto).
# Ex. OpenRouter: google/gemini-2.5-flash, anthropic/claude-3.5-sonnet, deepseek/deepseek-chat.
LLM_MODEL= # Local/Preview/Produção

# Chave da API Gemini (usada quando LLM_PROVIDER=gemini).
GEMINI_API_KEY= # Local/Preview/Produção
# Chave da API OpenRouter (usada quando LLM_PROVIDER=openrouter). https://openrouter.ai/keys
OPENROUTER_API_KEY= # Local/Preview/Produção

# Máx. de chamadas simultâneas ao LLM por requisição (evita rate limit 429).
# Comece baixo (3) — limites de RPM são por projeto. Default 3.
# (Aceita o nome antigo IA_GEMINI_CONCURRENCY por compatibilidade.)
IA_LLM_CONCURRENCY=3 # Local/Preview/Produção
