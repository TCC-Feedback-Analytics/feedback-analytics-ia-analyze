# Porta local do serviço ia-analyze.
PORT=4100 # Local

# Token interno das chamadas do API Gateway (igual ao IA_ANALYZE_REMOTE_TOKEN dele).
# É opcional só no dev local. Na Vercel ou com NODE_ENV=production, sem ele as
# rotas POST respondem 503.
IA_ANALYZE_INTERNAL_TOKEN= # Local/Produção

# ─────────────────────────────────────────────────────────────────────────────
# Provedor, modelo e chave não ficam neste serviço. O API Gateway envia a
# configuração OpenRouter de cada empresa nos headers internos `x-llm-*`.
# O código ainda lê LLM_PROVIDER, LLM_MODEL, OPENROUTER_API_KEY e GEMINI_API_KEY
# como fallback legado. Não use no fluxo padrão.
# ─────────────────────────────────────────────────────────────────────────────
# Máx. de chamadas simultâneas ao LLM por requisição (evita rate limit 429).
# Comece baixo. O limite de requisições é do provedor e da chave usada. Default 3.
# O nome antigo IA_GEMINI_CONCURRENCY ainda é aceito.
IA_LLM_CONCURRENCY=3 # Local/Produção
